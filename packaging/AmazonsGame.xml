<?xml version='1.0'?>
<SetupCollector xmlns:win="windows" xmlns:mac="macOS" xmlns:lin="linux" executableName="AmazonsGame">
	<Folders dev="~Desktop/GameOfTheAmazons" executable="$RAMDisk/Out/AmazonsGame/Release" out="$RAMDisk/Setup/AmazonsGame"/>
	<Packages debug="false">
		<Package name="natGUIALL"/>
		<Package name="GTK4" exclude="macOS,linux"/>
	</Packages>
	<ResData>
		<!-- GTK runtime schemas, Windows only -->
		<Res type="folder" dev="$MyBin/GTK/release/share/glib-2.0/schemas" dep="schemas" exclude="macOS,linux"/>
	</ResData>
	<MutableResource/>
	<Setup licenseFileName="~natID.SDK/DevEnv/License.txt"
			categories="Education;Games"
			win:programGroup="EH-MP-AM"
			win:width="440"
			win:headerBackColor="#30D5C8"
			win:headerTxtColor="#1A1A2E"
			win:licenseTxtColor="#846060"
			win:useMakeCabinet="true"
			win:minBuildNumber="17763"
			lin:depends="$DepGTKv4"
			lin:icon="$HOME/Desktop/GameOfTheAmazons/res/appIcon/lnxApp128"/>
</SetupCollector>
